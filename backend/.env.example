PORT=5000

# Local development postgres URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yedent

# Production (Neon) — use the POOLED URL in serverless environments (Vercel)
# DATABASE_URL_POOLED=postgresql://neondb_owner:...@...pooler...neon.tech/neondb?sslmode=require

JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=yedent
